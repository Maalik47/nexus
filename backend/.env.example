NODE_ENV=development
PORT=4000

# PostgreSQL connection
DATABASE_URL=postgres://nexusgear:nexusgear@localhost:5432/nexusgear
# Optional individual settings (used when DATABASE_URL is not present)
PGHOST=localhost
PGPORT=5432
PGUSER=nexusgear
PGPASSWORD=nexusgear
PGDATABASE=nexusgear

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Interoperability: key that external software uses (header: x-api-key)
EXTERNAL_API_KEY=change-me-external

# CORS: comma separated list of allowed origins, or * for all
CORS_ORIGIN=http://localhost:5173

# Outbound integration (software consuming third-party APIs)
# Point this to the other software's REST API to merge its data into our reports.
EXTERNAL_API_BASE_URL=https://api.example.com
EXTERNAL_API_KEY_HEADER=Authorization
EXTERNAL_API_KEY_VALUE=
# Path on the external API that returns its sales-like rows
EXTERNAL_REPORTS_PATH=/reports/sales
# Optional: locate a nested array inside the response and flatten nested items.
# Example for DummyJSON: RECORDS_PATH=carts  ITEMS_PATH=products
EXTERNAL_RECORDS_PATH=
EXTERNAL_ITEMS_PATH=
EXTERNAL_API_TIMEOUT_MS=10000
